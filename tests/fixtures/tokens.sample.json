  "$description": "Jeu d'essai figé pour le test de déterminisme (ne pas modifier sans mettre à jour le snapshot).",
  "color": {
    "light": {
      "background": "#ffffff",
      "surface": "#fafafa",
      "surfaceMuted": "#f0f0f0",
      "text": "#111111",
      "textMuted": "#555555",
      "border": "#dddddd",
      "accent": "#0055ff",
      "onAccent": "#ffffff",
      "success": "#008844",
      "warning": "#cc7700",
      "danger": "#cc0033",
      "focus": "#0055ff",
      "overlay": "#00000080"
    },
    "dark": {
      "background": "#101010",
      "surface": "#1a1a1a",
